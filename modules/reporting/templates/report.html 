<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Sayanox-One Penetration Test Report</title>
    <style>
        body { font-family: Arial, sans-serif; margin: 20px; }
        .header { text-align: center; border-bottom: 2px solid #333; padding-bottom: 10px; }
        .section { margin-top: 30px; }
        .vuln { border: 1px solid #ddd; padding: 15px; margin: 10px 0; border-radius: 5px; }
        .critical { border-left: 5px solid #dc3545; }
        .high { border-left: 5px solid #ffc107; }
        .medium { border-left: 5px solid #17a2b8; }
        .low { border-left: 5px solid #28a745; }
    </style>
</head>
<body>
    <div class="header">
        <h1>Sayanox-One Penetration Test Report</h1>
        <p>Target: {{ results.target }}</p>
        <p>Generated on: {{ now.strftime("%Y-%m-%d %H:%M:%S") }}</p>
    </div>

    {% for phase, data in results.phases.items() %}
    <div class="section">
        <h2>{{ phase.replace("_", " ").title() }}</h2>
        {% if data.vulnerabilities %}
            {% for vuln in data.vulnerabilities %}
            <div class="vuln {{ vuln.severity.lower() }}">
                <h3>{{ vuln.type }} ({{ vuln.severity }})</h3>
                <p><strong>Location:</strong> {{ vuln.url }}</p>
                <p><strong>Details:</strong> {{ vuln.details }}</p>
            </div>
            {% endfor %}
        {% else %}
            <p>No vulnerabilities found in this phase.</p>
        {% endif %}
    </div>
    {% endfor %}
</body>
</html>
